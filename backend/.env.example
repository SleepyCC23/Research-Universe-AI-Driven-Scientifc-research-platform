# ============================================================
# 研宇宙后端 · 环境变量模板（复制为 .env 后填写真实值）
# ============================================================

# ---- 服务 ----
# 后端端口（前端 vite.config.ts 的 proxy target 需与此一致）
PORT=8081
NODE_ENV=development

# ---- 数据库（MySQL 8）----
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/research_universe"

# ---- 鉴权 ----
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
SMS_DEV_RETURN_CODE=true

# ---- 大模型（任意 OpenAI 兼容厂商）----
# 例：OpenAI https://api.openai.com/v1
#     DeepSeek https://api.deepseek.com/v1
#     Moonshot(Kimi) https://api.moonshot.cn/v1
#     通义 https://dashscope.aliyuncs.com/compatible-mode/v1
#     智谱 https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_TIMEOUT_MS=120000

# ---- 数据分析（Python 真实计算）----
PYTHON_BIN="python"
PYTHON_TIMEOUT_MS=180000
ANALYSIS_MODE=python

# ---- 外部数据源 ----
OPENALEX_MAILTO=""

# ---- 上传目录 ----
UPLOAD_DIR="uploads"
